# Runs the daemon as its own user with network capabilities, as the hardened
# NixOS module does, with the sandboxing from upstream's
# release_files/systemd/netbird@.service.
[Unit]
Description=NetBird mesh network client
Documentation=https://docs.netbird.io/
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/netbird service run --log-level info --log-file console --daemon-addr unix:///run/netbird/netbird.sock
EnvironmentFile=-/etc/sysconfig/netbird
Environment=SYSTEMD_UNIT=netbird.service
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

User=netbird
Group=netbird
StateDirectory=netbird
StateDirectoryMode=0700
# The CLI and UI find the socket in /run/netbird.
RuntimeDirectory=netbird
RuntimeDirectoryMode=0755
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
PrivateMounts=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
# The daemon writes net.ipv4.conf.* sysctls for its routes.
ProtectKernelTunables=no
ProtectSystem=strict
RemoveIPC=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
