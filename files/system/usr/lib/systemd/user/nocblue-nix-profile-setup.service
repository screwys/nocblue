[Unit]
Description=Install nocblue Nix developer tools
Wants=network-online.target
After=network-online.target
ConditionUser=!@system
ConditionPathIsDirectory=%h

[Service]
Type=oneshot
ExecStart=/usr/bin/nocblue-setup-nix-profile
Restart=on-failure
RestartSec=30s
RestartMaxDelaySec=1800s
RestartSteps=10

[Install]
WantedBy=default.target
