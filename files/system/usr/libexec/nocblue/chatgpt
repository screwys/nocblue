#!/usr/bin/bash
set -euo pipefail

unset LD_PRELOAD
if [[ -r /etc/ld.so.preload || -r /usr/etc/ld.so.preload ]]; then
    exec /usr/bin/bwrap \
        --dev-bind / / \
        --ro-bind-try /dev/null /etc/ld.so.preload \
        --ro-bind-try /dev/null /usr/etc/ld.so.preload \
        --unsetenv LD_PRELOAD \
        -- /usr/lib/chatgpt/codex-launcher --class=Codex --ozone-platform=wayland "$@" >/dev/null 2>&1
fi

exec /usr/lib/chatgpt/codex-launcher --class=Codex --ozone-platform=wayland "$@" >/dev/null 2>&1
