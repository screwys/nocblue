#!/usr/bin/python3
"""Restore the portable profile, then add missing nocblue tools."""

import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def write_state(path, contents):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as temporary:
        temporary.write(contents)
    os.replace(temporary.name, path)


def elements(manifest):
    entries = manifest.get("elements", {})
    return entries.values() if isinstance(entries, dict) else entries


def installable(element, locked=True):
    original = element.get("originalUrl") or element.get("originalUri")
    source = (element.get("url") or element.get("uri") or original) if locked else original
    if not source:
        return None
    ref = source + "#" + element.get("attrPath", "")
    if element.get("outputs"):
        ref += "^" + ",".join(element["outputs"])
    return ref


def nix(*arguments, capture=False):
    return subprocess.run(["nix", *arguments], check=True, text=True,
                          stdout=subprocess.PIPE if capture else None)


def installed_packages():
    manifest = json.loads(nix("profile", "list", "--json", capture=True).stdout)
    return [entry for entry in elements(manifest) if entry.get("active", True)]


def prepare_migration(home, state_home):
    nix_state = Path(os.environ.get("NIX_STATE_HOME", state_home / "nix"))
    profiles = nix_state / "profiles"
    pointers = [home / ".nix-profile", nix_state / "profile", profiles / "profile"]
    portable = Path(os.environ.get("NP_LOCATION", home)) / ".nix-portable"
    migration = state_home / "nocblue/nix-portable-migration"
    migration.mkdir(mode=0o700, parents=True, exist_ok=True)
    migration.chmod(0o700)
    if (migration / "prepared").exists():
        return migration

    def old_manifest(pointer):
        target = pointer.resolve()
        if not str(target).startswith("/nix/store/"):
            return None
        if (target / "manifest.json").exists():
            return None
        physical = portable / str(target).lstrip("/") / "manifest.json"
        return physical if physical.exists() else None

    saved_manifest = migration / "manifest.json"
    if not saved_manifest.exists():
        for pointer in pointers:
            if not pointer.is_symlink():
                continue
            source = old_manifest(pointer)
            if source:
                write_state(saved_manifest, source.read_text())
                break
            target = pointer.resolve()
            if str(target).startswith("/nix/store/") and not target.exists() and portable.exists():
                raise RuntimeError(f"Cannot read the old profile manifest for {pointer}; the portable store remains unchanged.")

    selections = []
    links = []
    if saved_manifest.exists():
        for entry in elements(json.loads(saved_manifest.read_text())):
            if not entry.get("active", True):
                continue
            ref = installable(entry)
            refs = [ref] if ref else entry.get("storePaths", [])
            if not refs:
                raise RuntimeError("An active portable package has no source or store path; see the saved manifest.")
            selections.append({"refs": refs, "priority": entry.get("priority", 5), "attrPath": entry.get("attrPath")})

        generations = [pointer for pointer in profiles.glob("profile-*-link")
                       if re.fullmatch(r"profile-\d+-link", pointer.name)]
        candidates = pointers + generations
        for pointer in dict.fromkeys(candidates):
            if pointer.is_symlink() and old_manifest(pointer):
                links.append({"path": str(pointer), "target": os.readlink(pointer)})

    write_state(migration / "selections.json", json.dumps(selections, indent=2) + "\n")
    links_file = migration / "symlinks.json"
    if not links_file.exists():
        write_state(links_file, json.dumps(links, indent=2) + "\n")
    for link in json.loads(links_file.read_text()):
        pointer = Path(link["path"])
        if pointer.is_symlink() and os.readlink(pointer) == link["target"]:
            pointer.unlink()

    shim_manifest = state_home / "nocblue/nix-profile-shims"
    if shim_manifest.exists():
        backup = migration / "shims"
        backup.mkdir(mode=0o700, exist_ok=True)
        write_state(migration / "nix-profile-shims", shim_manifest.read_text())
        for name in shim_manifest.read_text().splitlines():
            if not re.fullmatch(r"[A-Za-z0-9._+-]+", name):
                continue
            shim = home / ".local/bin" / name
            if not shim.is_file() or shim.is_symlink():
                continue
            with shim.open() as contents:
                header = [contents.readline().rstrip("\n"), contents.readline().rstrip("\n")]
            if "# nocblue-nix-profile-shim v1" in header:
                shutil.copy2(shim, backup / name)
                shim.unlink()
        shim_manifest.unlink()
    write_state(migration / "prepared", "1\n")
    return migration


def main():
    if os.getuid() == 0:
        raise RuntimeError("Run Nix profile setup as the desktop user.")
    home = Path.home()
    state_home = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state"))
    migration = prepare_migration(home, state_home)
    failures = []
    installed = installed_packages()
    selections = json.loads((migration / "selections.json").read_text())
    for selection in selections:
        refs = selection["refs"]
        present = {installable(entry) for entry in installed}
        present.update(installable(entry, locked=False) for entry in installed)
        present.update(path for entry in installed for path in entry.get("storePaths", []))
        if all(ref in present for ref in refs):
            continue
        try:
            nix("profile", "install", "--priority", str(selection["priority"]), *refs)
            installed = installed_packages()
        except subprocess.CalledProcessError:
            failures.append(refs)
            print(f"Could not restore {refs}; saved selections and the old portable store remain available.", file=sys.stderr)

    manifest = Path(os.environ.get("NOCBLUE_NIX_PROFILE_MANIFEST", "/usr/share/nocblue/manifests/nix-profile.txt"))
    for line in manifest.read_text().splitlines():
        ref = line.strip()
        if not ref or ref.startswith("#"):
            continue
        attrs = {entry.get("attrPath") for entry in installed}
        attrs.update(selection.get("attrPath") for selection in selections)
        if ref.partition("#")[2] in attrs:
            continue
        nix("profile", "install", ref)
        installed = installed_packages()

    write_state(state_home / "nocblue/nix-profile-count", str(len(installed)) + "\n")
    if failures:
        return 1
    write_state(migration / "restored", "1\n")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, subprocess.CalledProcessError) as error:
        print(f"nocblue-setup-nix-profile: {error}", file=sys.stderr)
        sys.exit(1)
