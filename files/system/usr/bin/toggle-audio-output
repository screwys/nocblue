#!/bin/bash
# Toggle between SteelSeries Arctis 1 Wireless and Built-in Audio

WIRELESS="alsa_output.usb-SteelSeries_SteelSeries_Arctis_1_Wireless-00.analog-stereo"
BUILTIN="alsa_output.pci-0000_00_1f.3.analog-stereo"

current=$(pactl get-default-sink)

if [ "$current" = "$WIRELESS" ]; then
    pactl set-default-sink "$BUILTIN"
    notify-send -t 2000 "Audio Output" "Switched to Built-in Audio"
else
    pactl set-default-sink "$WIRELESS"
    notify-send -t 2000 "Audio Output" "Switched to SteelSeries Arctis 1"
fi
