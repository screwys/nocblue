#!/usr/bin/env bash
# Switch the default output to the next available sink.
set -euo pipefail

mapfile -t sinks < <(pactl list short sinks | cut -f2)
(( ${#sinks[@]} > 1 )) || exit 0

current="$(pactl get-default-sink)"
next="${sinks[0]}"
for i in "${!sinks[@]}"; do
    if [[ "${sinks[$i]}" == "${current}" ]]; then
        next="${sinks[$(( (i + 1) % ${#sinks[@]} ))]}"
        break
    fi
done

pactl set-default-sink "${next}"
description="$(pactl -f json list sinks | jq -r --arg name "${next}" '.[] | select(.name == $name) | .description')"
notify-send -t 2000 "Audio Output" "Switched to ${description:-${next}}"
