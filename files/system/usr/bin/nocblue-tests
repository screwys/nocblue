#!/usr/bin/env bash
set -Eeuo pipefail
trap 'status=$?; printf "nocblue-tests:%s: command failed (exit %s): %s\n" "$LINENO" "$status" "$BASH_COMMAND" >&2; exit "$status"' ERR

test ! -e /usr/bin/sudo
command -v run0 >/dev/null
command -v kioclient >/dev/null

rpm -q kernel kernel-core kernel-modules-core xwayland-satellite t3code-nightly >/dev/null
if rpm -q kernel-cachyos kernel-cachyos-devel-matched cachyos-settings >/dev/null 2>&1; then
    printf 'CachyOS kernel packages must not replace the Fedora kernel\n' >&2
    exit 1
fi
if find /usr/lib/modules -maxdepth 1 -mindepth 1 -type d -name '*cachyos*' | grep -q .; then
    printf 'unexpected CachyOS kernel module directory\n' >&2
    exit 1
fi

for cmd in niri noctalia noctalia-greeter noctalia-greeter-session noctalia-greeter-compositor nocblue-noctalia-greeter-session greetd gnome-control-center fish fastfetch wl-copy wl-paste wf-recorder wlsunset kdeconnectd firefox librewolf mullvad-browser trivalent brave-origin-beta helium zed t3code-nightly claude-desktop voxtype magick tesseract ujust njust loupe showtime bwrap xdg-dbus-proxy flatpak-builder patch pywalfox nm-connection-editor nmtui java javac go cargo rustc gcc g++ make cmake pkg-config curl unzip 7z ffmpeg docker podman podman-compose cosign openrazer-daemon nocblue-setup-android-sdk nocblue-ocr-japanese nocblue-check-secureblue-base nocblue-verify-update-signature xdg-open nix; do
    command -v "${cmd}" >/dev/null 2>&1 || {
        printf 'missing expected command: %s\n' "${cmd}" >&2
        exit 1
    }
done

rpm -q --whatprovides openrazer-kmod-common >/dev/null
rpm -q --whatprovides openrazer-kernel-modules-dkms >/dev/null
if rpm -qa --qf '%{NAME}\n' | grep -qx 'openrazer-kernel-modules-dkms'; then
    printf 'OpenRazer must use signed kernel modules instead of DKMS\n' >&2
    exit 1
fi
test ! -u /usr/lib/claude-desktop/chrome-sandbox
test ! -g /usr/lib/claude-desktop/chrome-sandbox
test ! -u /usr/lib64/t3code-nightly/chrome-sandbox
test ! -g /usr/lib64/t3code-nightly/chrome-sandbox
test -x /usr/lib64/t3code-nightly/t3code.node
test -x /usr/libexec/claude-sandbox/apply-seccomp
test -x /usr/libexec/claude-sandbox/bwrap
voxtype --version >/dev/null
test -r /usr/share/voxtype/models/ggml-base.bin
python3 -c 'import openrazer_daemon; import openrazer.client; import proton.vpn.platform.local_agent'

if rpm -q ffmpeg-free-devel >/dev/null 2>&1; then
    printf 'restricted ffmpeg-free-devel must not replace the full FFmpeg provider\n' >&2
    exit 1
fi
if rpm -q libavcodec-free >/dev/null 2>&1; then
    printf 'restricted libavcodec-free must not replace the full H.264 decoder\n' >&2
    exit 1
fi
ffmpeg_decoders="$(ffmpeg -hide_banner -decoders 2>/dev/null)"
grep -Eq '^ V[^ ]*D h264[[:space:]]' <<<"${ffmpeg_decoders}"

mapfile -t openrazer_modules < <(find /usr/lib/modules -path '*/extra/openrazer/razer*.ko*' -type f | sort)
((${#openrazer_modules[@]} > 0))
enrollment_cert="$(python3 - <<'PY'
import sys
sys.path.insert(0, "/usr/libexec/secureblue")
from enroll_secure_boot_keys import required_mok_cert
print(required_mok_cert())
PY
)"
enrollment_serial="$(openssl x509 -inform DER -in "${enrollment_cert}" -noout -serial | cut -d= -f2 | tr '[:upper:]' '[:lower:]')"
for module_path in "${openrazer_modules[@]}"; do
    signer="$(modinfo -F signer "${module_path}")"
    if [[ -z "${signer}" ]]; then
        printf 'unsigned OpenRazer kernel module: %s\n' "${module_path}" >&2
        exit 1
    fi
    module_key="$(modinfo -F sig_key "${module_path}" | tr -d ':' | tr '[:upper:]' '[:lower:]')"
    if [[ "${module_key}" != "${enrollment_serial}" ]]; then
        printf 'OpenRazer signing key does not match the enrollment certificate: %s\n' "${module_path}" >&2
        exit 1
    fi
done

LD_PRELOAD='libhardened_malloc.so libno_rlimit_as.so' uv --version >/dev/null
LD_PRELOAD='libhardened_malloc.so libno_rlimit_as.so' uvx --version >/dev/null

if rpm -q protonvpn-stable-release >/dev/null 2>&1; then
    printf 'unexpected protonvpn-stable-release package\n' >&2
    exit 1
fi
for pkg in chatgpt docker-ce docker-ce-cli docker-ce-rootless-extras containerd.io docker-buildx-plugin docker-compose-plugin ptyxis gnome-terminal gnome-terminal-nautilus gnome-console kgx gnome-classic-session lxqt-policykit torbrowser-launcher temurin-17-jdk; do
    if rpm -q "${pkg}" >/dev/null 2>&1; then
        printf 'removed package is still installed: %s\n' "${pkg}" >&2
        exit 1
    fi
done

if (( $(rpm -E '%fedora') >= 45 )); then
    rpm -q oo7-daemon pam_oo7 oo7-portal >/dev/null
    systemctl --global is-enabled oo7-daemon.service >/dev/null
else
    rpm -q gnome-keyring gnome-keyring-pam >/dev/null
fi

for brew_service in brew-update.service brew-upgrade.service; do
    brew_unit="/usr/lib/systemd/system/${brew_service}"
    test "$(rpm -qf --qf '%{NAME}\n' "${brew_unit}")" = homebrew
    grep -qx 'User=linuxbrew' "${brew_unit}"
done

preload_file=
if [[ -f /etc/ld.so.preload ]]; then
    preload_file=/etc/ld.so.preload
elif [[ -f /usr/etc/ld.so.preload ]]; then
    preload_file=/usr/etc/ld.so.preload
fi
[[ -n "${preload_file}" ]]
grep -Fq 'libhardened_malloc.so' "${preload_file}"
grep -Fq 'libno_rlimit_as.so' "${preload_file}"

for nix_flag in '' 'NOCBLUE_NIX_ENV=1'; do
    loader_env="$(
        env -u BASH_ENV -u LD_PRELOAD -u LD_AUDIT ${nix_flag:+"${nix_flag}"} \
            /usr/bin/bash --noprofile --norc -c '. /etc/bashrc; printf "%s|%s\n" "${LD_PRELOAD-}" "${LD_AUDIT-}"'
    )"
    test "${loader_env}" = '|'
done

test ! -e /etc/profile.d/nix-daemon.sh
test ! -e /usr/lib/systemd/system/nix-daemon.service
test ! -e /usr/lib/systemd/system/nix-daemon.socket

test "$(readlink /etc/systemd/system/display-manager.service)" = "/usr/lib/systemd/system/greetd.service"
for masked_unit in rpm-ostree-countme.timer geoclue.service sshd.service sshd.socket sshd-keygen.target; do
    test "$(readlink "/etc/systemd/system/${masked_unit}")" = "/dev/null"
done

ptrace_file=
if [[ -f /etc/sysctl.d/61-ptrace-scope.conf ]]; then
    ptrace_file=/etc/sysctl.d/61-ptrace-scope.conf
elif [[ -f /usr/etc/sysctl.d/61-ptrace-scope.conf ]]; then
    ptrace_file=/usr/etc/sysctl.d/61-ptrace-scope.conf
fi
[[ -n "${ptrace_file}" ]]
grep -qx 'kernel.yama.ptrace_scope = 1' "${ptrace_file}"

command -v sesearch >/dev/null
command -v seinfo >/dev/null
selinux_policy_dir=/etc/selinux/targeted/policy
if [[ ! -d "${selinux_policy_dir}" ]]; then
    selinux_policy_dir=/usr/etc/selinux/targeted/policy
fi
selinux_policy_path="$(find "${selinux_policy_dir}" -maxdepth 1 -name 'policy.*' 2>/dev/null | sort -V | tail -n 1)"
test -n "${selinux_policy_path}"
sesearch() {
    /usr/bin/sesearch "$@" "${selinux_policy_path}"
}
seinfo() {
    /usr/bin/seinfo "$@" "${selinux_policy_path}"
}

if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
    semodule -l 2>/dev/null | awk '{print $1}' | grep -qx deny_ipsec
    semodule -l 2>/dev/null | awk '{print $1}' | grep -qx nocblue_sandbox_userns
    if semodule -l 2>/dev/null | awk '{print $1}' | grep -qx nocblue_browser_userns; then
        printf 'obsolete nocblue_browser_userns module is still installed\n' >&2
        exit 1
    fi
fi

test "$(matchpathcon -n /usr/bin/nocblue-browser-no-preload)" = "system_u:object_r:nocblue_browser_no_preload_exec_t:s0"
test "$(matchpathcon -n /usr/lib64/t3code-nightly/t3code)" = "system_u:object_r:t3code_launcher_exec_t:s0"
test "$(matchpathcon -n /usr/lib64/t3code-nightly/t3code.bin)" = "system_u:object_r:t3code_exec_t:s0"
test "$(matchpathcon -n /usr/lib64/t3code-nightly/t3code.node)" = "system_u:object_r:bin_t:s0"
test "$(matchpathcon -n /usr/libexec/claude-sandbox/apply-seccomp)" = "system_u:object_r:claude_sandbox_helper_exec_t:s0"
test "$(matchpathcon -n /usr/lib/claude-desktop/claude-desktop)" = "system_u:object_r:claude_desktop_launcher_exec_t:s0"
test "$(matchpathcon -n /usr/lib/claude-desktop/claude-desktop.bin)" = "system_u:object_r:claude_desktop_exec_t:s0"
test "$(matchpathcon -n /usr/lib/claude-desktop/chrome_crashpad_handler)" = "system_u:object_r:claude_desktop_exec_t:s0"
test "$(matchpathcon -n /usr/lib/claude-desktop/resources/cowork-linux-helper)" = "system_u:object_r:bin_t:s0"
if command -v selinuxenabled >/dev/null 2>&1 && selinuxenabled; then
    matchpathcon -V \
        /usr/bin/nocblue-browser-no-preload \
        /usr/lib64/t3code-nightly/t3code \
        /usr/lib64/t3code-nightly/t3code.bin \
        /usr/lib64/t3code-nightly/t3code.node \
        /usr/libexec/claude-sandbox/apply-seccomp \
        /usr/lib/claude-desktop/claude-desktop \
        /usr/lib/claude-desktop/claude-desktop.bin \
        /usr/lib/claude-desktop/chrome_crashpad_handler \
        /usr/lib/claude-desktop/resources/cowork-linux-helper
fi

for domain in claude_desktop_launcher_t claude_desktop_t t3code_launcher_t t3code_t claude_sandbox_helper_t nocblue_browser_no_preload_t; do
    if seinfo --permissive "${domain}" | grep -Fq "${domain}"; then
        printf 'unexpected permissive domain: %s\n' "${domain}" >&2
        exit 1
    fi
done

if sesearch -A -s unconfined_t -t claude_desktop_launcher_t -c process -p noatsecure | grep -q .; then
    printf 'Claude launcher must enter secure-execution mode\n' >&2
    exit 1
fi
if sesearch -A -s unconfined_t -t t3code_launcher_t -c process -p noatsecure | grep -q .; then
    printf 'T3 launcher must enter secure-execution mode\n' >&2
    exit 1
fi
if sesearch -A -s claude_sandbox_helper_t -c file -p execute_no_trans | grep -q .; then
    printf 'Claude sandbox commands must leave the helper domain\n' >&2
    exit 1
fi
sesearch -T -s t3code_launcher_t -t bin_t -c process \
    | grep -Fxq 'type_transition t3code_launcher_t bin_t:process unconfined_t;'
sesearch -T -s claude_sandbox_helper_t -t shell_exec_t -c process \
    | grep -Fxq 'type_transition claude_sandbox_helper_t shell_exec_t:process unconfined_t;'

sesearch -T -s claude_desktop_t -t user_home_dir_t -c file \
    | grep -Fxq 'type_transition claude_desktop_t user_home_dir_t:file user_home_t;'
sesearch -T -s claude_desktop_t -t config_home_t -c process \
    | grep -Fxq 'type_transition claude_desktop_t config_home_t:process unconfined_t;'

for userns_domain in \
    nocblue_browser_no_preload_t \
    claude_desktop_launcher_t \
    claude_desktop_t \
    t3code_launcher_t \
    t3code_t \
    claude_sandbox_helper_t \
    brave_origin_t \
    helium_t \
    nocblue_firefox_t; do
    sesearch -A -s "${userns_domain}" -t "${userns_domain}" -c user_namespace -p create \
        | grep -Fxq "allow ${userns_domain} ${userns_domain}:user_namespace create;"
    if seinfo -t "${userns_domain}" -x | grep -q 'unconfined_domain_type'; then
        printf 'unexpected unconfined_domain_type for %s\n' "${userns_domain}" >&2
        exit 1
    fi
done

for denied_userns_domain in unconfined_t mozilla_t staff_t user_t xdm_t; do
    if sesearch -A -s "${denied_userns_domain}" -c user_namespace -p create | grep -q .; then
        printf 'unexpected user_namespace create allow for %s\n' "${denied_userns_domain}" >&2
        exit 1
    fi
done

sesearch -T -s unconfined_t -t flatpak_exec_t -c process \
    | grep -Fxq 'type_transition unconfined_t flatpak_exec_t:process flatpak_t;'
sesearch -A -Sp -s unconfined_t -t flatpak_t -c process2 -p nnp_transition,nosuid_transition | grep -q .
sesearch -T -s flatpak_t -t bubblewrap_exec_t -c process \
    | grep -Fxq 'type_transition flatpak_t bubblewrap_exec_t:process flatpak_bubblewrap_t;'
sesearch -A -Sp -s flatpak_t -t flatpak_bubblewrap_t -c process2 -p nnp_transition,nosuid_transition | grep -q .

# Flatpak host launches must enter the browser launcher before starting browsers.
sesearch -T -s flatpak_t -t nocblue_browser_no_preload_exec_t -c process \
    | grep -Fxq 'type_transition flatpak_t nocblue_browser_no_preload_exec_t:process nocblue_browser_no_preload_t;'
sesearch -A -s flatpak_t -t nocblue_browser_no_preload_t -c process -p transition | grep -q .
sesearch -A -Sp -s flatpak_t -t nocblue_browser_no_preload_t -c process2 -p nnp_transition,nosuid_transition | grep -q .

for bwrap_domain in flatpak_bubblewrap_t unconfined_bubblewrap_t; do
    sesearch -A -s "${bwrap_domain}" -t "${bwrap_domain}" -c user_namespace -p create \
        | grep -Fxq "allow ${bwrap_domain} ${bwrap_domain}:user_namespace create;"
    sesearch -A -s "${bwrap_domain}" -t non_security_file_type -c dir -p mounton | grep -q .
    sesearch -A -s "${bwrap_domain}" -t non_security_file_type -c file -p mounton | grep -q .
    sesearch -A -s "${bwrap_domain}" -t non_security_file_type -c sock_file -p mounton | grep -q .
    sesearch -A -s "${bwrap_domain}" -t null_device_t -c chr_file -p mounton | grep -q .
done

for clipboard_peer in \
    unconfined_trivalent_t \
    brave_origin_t \
    helium_t \
    nocblue_firefox_t \
    claude_desktop_t \
    t3code_t \
    flatpak_t; do
    sesearch -A -s "${clipboard_peer}" -t flatpak_t -c fd -p use | grep -q .
    sesearch -A -s flatpak_t -t "${clipboard_peer}" -c fd -p use | grep -q .
    sesearch -A -Sp -s "${clipboard_peer}" -t flatpak_t -c fifo_file -p getattr,open,read,write | grep -q .
    sesearch -A -Sp -s flatpak_t -t "${clipboard_peer}" -c fifo_file -p getattr,open,read,write | grep -q .
done

if /usr/bin/nocblue-browser-no-preload /usr/bin/unshare -Ur true >/dev/null 2>&1; then
    printf 'browser launcher accepted an unsupported command\n' >&2
    exit 1
fi

test -f /usr/share/nocblue/media-patches/loupe-reuse-active-window.patch-applied
test -f /usr/share/nocblue/media-patches/showtime-reuse-window.patch-applied
grep -q '^Exec=/usr/bin/nocblue-bwrap-loupe %U$' /usr/share/applications/org.gnome.Loupe.desktop
grep -q '^Exec=/usr/bin/nocblue-bwrap-showtime %U$' /usr/share/applications/org.gnome.Showtime.desktop

grep -q 'NOCBLUE_BROWSER_NO_PRELOAD' /usr/bin/firefox
grep -q 'NOCBLUE_BROWSER_NO_PRELOAD' /usr/lib/mullvad-browser/start-mullvad-browser
grep -q 'NOCBLUE_BROWSER_NO_PRELOAD' /opt/brave.com/brave-origin-beta/brave-origin-beta
grep -q 'NOCBLUE_BROWSER_NO_PRELOAD' /opt/helium/helium-wrapper
grep -Fqx 'exec /usr/bin/nocblue-browser-no-preload /usr/share/librewolf/librewolf "$@"' /usr/bin/librewolf

test -f /usr/share/wayland-sessions/gnome.desktop
test ! -e /usr/share/wayland-sessions/gnome-classic.desktop
test -f /usr/share/wayland-sessions/niri.desktop

niri validate -c /etc/xdg/niri/config.kdl
