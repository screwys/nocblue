#!/usr/bin/bash -p
set -euo pipefail

unset LD_PRELOAD LD_AUDIT LD_LIBRARY_PATH
export T3CODE_TELEMETRY_ENABLED=false
export T3CODE_DESKTOP_LAUNCHER_PATH=/usr/bin/t3code-nightly
target=/usr/lib64/t3code-nightly/t3code.bin
args=(--disable-setuid-sandbox)
if [[ -n "${ELECTRON_RUN_AS_NODE:-}" ]]; then
    target=/usr/lib64/t3code-nightly/t3code.node
    args=()
else
    unset NODE_OPTIONS
fi

# Use glibc without changing the user namespace inherited by SSH and agents.
export LD_PRELOAD=/usr/lib64/libc.so.6
exec "${target}" "${args[@]}" "$@"
