// Public nocblue niri baseline. Private machine-specific outputs and app pins
// belong in the user's dotfiles repo, not in this image.

prefer-no-csd
screenshot-path null

environment {
    XCURSOR_SIZE "24"
    XCURSOR_THEME "Acheron"
    PYTHON_KEYRING_BACKEND "keyring.backends.SecretService.Keyring"
    BROWSER "/usr/bin/xdg-open"
    EDITOR "nvim"
    VISUAL "nvim"
    TERMINAL "/usr/bin/ghostty"
    SHELL "/bin/fish"
    PYTHONPATH "/usr/lib/python3.14/site-packages"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"

    GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    XMODIFIERS "@im=fcitx"
}

input {
    keyboard {
        xkb {
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    workspace-auto-back-and-forth
}

cursor {
    xcursor-theme "Acheron"
    xcursor-size 24
}

layout {
    gaps 16
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 3
    }

    border {
        off
    }

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}

blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.5
}

layer-rule {
    match namespace="^noctalia-wallpaper.*"
    place-within-backdrop true
}

window-rule {
    match app-id="org.gnome.Nautilus" is-floating=true
    default-column-width { fixed 1500; }
    default-window-height { fixed 1200; }
    min-width 1500
    min-height 1200
}

window-rule {
    match app-id=r"^(librewolf|firefox|org\.mozilla\.firefox|mullvad-browser|Mullvad Browser|trivalent|brave-origin-beta|helium)$"
    open-maximized true
}

window-rule {
    match app-id=r"^org\.gnome\.Fractal$"
    default-column-width { proportion 0.5; }
    default-window-height { proportion 1.0; }
    default-floating-position x=0 y=0 relative-to="right"
    open-floating true
    block-out-from "screencast"
}

window-rule {
    match app-id="steam" title=r"^notificationtoasts_\d+_desktop$"
    default-floating-position x=0 y=0 relative-to="bottom-right"
    open-focused false
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    draw-border-with-background false
    opacity 0.9

    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match is-focused=true

    background-effect {
        blur true
    }
}

spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "DISPLAY" "XDG_CURRENT_DESKTOP" "XDG_SESSION_TYPE" "NIRI_SOCKET"
spawn-at-startup "nocblue-refresh-portals"
spawn-at-startup "sh" "-lc" "sleep 4; command -v xembedsniproxy >/dev/null 2>&1 && exec xembedsniproxy"

binds {


    MOD+SHIFT+ESCAPE                     { show-hotkey-overlay; }

    // ─── Applications ───
    MOD+RETURN hotkey-overlay-title="Open Terminal: Ghostty" { spawn "ghostty" "--gtk-single-instance=false" "--command=/bin/fish"; }
    MOD+CTRL+RETURN hotkey-overlay-title="Open App Launcher: noctalia launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    MOD+B hotkey-overlay-title="Open Browser: librewolf" { spawn "librewolf"; }
    MOD+N hotkey-overlay-title="Notes" { spawn "noctalia" "msg" "panel-toggle" "noctalia/notes:panel"; }
    MOD+T hotkey-overlay-title="Open todo.txt" { spawn "noctalia" "msg" "panel-toggle" "screwys/todotxt:panel"; }
    MOD+SHIFT+T hotkey-overlay-title="Add todo.txt task" { spawn "noctalia" "msg" "panel-open" "screwys/todotxt:panel" "add"; }
    MOD+ALT+N hotkey-overlay-title="Restart Noctalia" { spawn "restart-noctalia"; }
    Mod+SHIFT+L hotkey-overlay-title="Lock Screen: noctalia lock" { spawn "noctalia" "msg" "session" "lock"; }
    MOD+E hotkey-overlay-title="File Manager: Nautilus" { spawn "nautilus-default-path"; }
    MOD+C hotkey-overlay-title="CLipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    MOD+Z hotkey-overlay-title="Zed" { spawn "zed"; }
    MOD+SHIFT+C hotkey-overlay-title="Calculator" { spawn "noctalia" "msg" "panel-toggle" "yuuto/calculator:panel"; }
    MOD+SHIFT+D { spawn-sh "noctalia msg plugin alok-debnath/shelf:service all toggle"; }

    // ─── Screenshots ───
    PRINT hotkey-overlay-title="Screenshot Region" { spawn "noctalia" "msg" "screenshot-region"; }
    ALT+PRINT hotkey-overlay-title="Screenshot Focused Window" { screenshot-window; }

    // ─── Audio Controls ───
    MOD+V hotkey-overlay-title="Toggle Audio Output" { spawn "toggle-audio-output"; }
    XF86AUDIORAISEVOLUME allow-when-locked=true repeat=false { spawn "noctalia" "msg" "volume-up"; }
    XF86AUDIOLOWERVOLUME allow-when-locked=true repeat=false { spawn "noctalia" "msg" "volume-down"; }
    XF86AUDIOMUTE allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AUDIOMICMUTE allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    // ─── Media Controls ───
    XF86AUDIOPLAY allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AUDIOPREV allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AUDIONEXT allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AUDIOSTOP allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }

    // ─── Window Movement and Focus ───
    MOD+Q                               { close-window; }
    MOD+LEFT                            { focus-column-left; }
    MOD+RIGHT                           { focus-column-right; }
    MOD+SHIFT+UP                              { focus-window-up; }
    MOD+K                               { focus-window-up; }
    MOD+SHIFT+DOWN                            { focus-window-down; }
    MOD+J                               { focus-window-down; }

    MOD+CTRL+LEFT                       { move-column-left; }
    MOD+CTRL+H                          { move-column-left; }
    MOD+CTRL+RIGHT                      { move-column-right; }
    MOD+CTRL+L                          { move-column-right; }
    MOD+CTRL+UP                         { move-window-up; }
    MOD+CTRL+K                          { move-window-up; }
    MOD+CTRL+DOWN                       { move-window-down; }
    MOD+CTRL+J                          { move-window-down; }

    MOD+HOME                            { focus-column-first; }
    MOD+END                             { focus-column-last; }
    MOD+CTRL+HOME                       { move-column-to-first; }
    MOD+CTRL+END                        { move-column-to-last; }

    MOD+SHIFT+LEFT                      { focus-monitor-left; }
    MOD+SHIFT+RIGHT                     { focus-monitor-right; }
    MOD+SHIFT+CTRL+LEFT                 { move-column-to-monitor-left; }
    MOD+SHIFT+CTRL+RIGHT                { move-column-to-monitor-right; }
    MOD+SHIFT+CTRL+UP                   { move-column-to-monitor-up; }
    MOD+SHIFT+CTRL+DOWN                 { move-column-to-monitor-down; }

    // ─── Workspace Switching ───
    MOD+WHEELSCROLLDOWN cooldown-ms=150 { focus-workspace-down; }
    MOD+DOWN cooldown-ms=150 { focus-workspace-down; }
    MOD+WHEELSCROLLUP cooldown-ms=150 { focus-workspace-up; }
    MOD+UP cooldown-ms=150 { focus-workspace-up; }
    MOD+1                               { focus-workspace 1; }
    MOD+2                               { focus-workspace 2; }
    MOD+3                               { focus-workspace 3; }
    MOD+4                               { focus-workspace 4; }
    MOD+5                               { focus-workspace 5; }
    MOD+6                               { focus-workspace 6; }
    MOD+7                               { focus-workspace 7; }
    MOD+8                               { focus-workspace 8; }
    MOD+9                               { focus-workspace 9; }
    MOD+CTRL+1                          { move-column-to-workspace 1; }
    MOD+CTRL+2                          { move-column-to-workspace 2; }
    MOD+CTRL+3                          { move-column-to-workspace 3; }
    MOD+CTRL+4                          { move-column-to-workspace 4; }
    MOD+CTRL+5                          { move-column-to-workspace 5; }
    MOD+CTRL+6                          { move-column-to-workspace 6; }
    MOD+CTRL+7                          { move-column-to-workspace 7; }
    MOD+CTRL+8                          { move-column-to-workspace 8; }
    MOD+CTRL+9                          { move-column-to-workspace 9; }
    MOD+TAB                             { focus-workspace-previous; }

    // ─── Layout Controls ───
    MOD+F                          { maximize-column; }
    MOD+R                               { switch-preset-column-width; }
    MOD+SHIFT+R                         { switch-preset-column-width-back; }
    MOD+CTRL+SHIFT+R                    { switch-preset-window-height; }
    MOD+CTRL+R                          { reset-window-height; }
    MOD+MINUS                           { set-column-width "-10%"; }
    MOD+EQUAL                           { set-column-width "+10%"; }
    MOD+SHIFT+E                         { consume-or-expel-window-left; }
    // ─── Modes ───
    MOD+H                               { toggle-window-floating; }
    MOD+CTRL+F                               { fullscreen-window; }
    MOD+W                               { toggle-column-tabbed-display; }

    // ─── Emergency Escape ───
    MOD+ESCAPE allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+DELETE                     { quit; }
    MOD+SHIFT+P                         { power-off-monitors; }
    MOD+O repeat=false { toggle-overview; }

    // ─── Final Razer M-Key Bindings (Linear + Shifted mix) ───
    XF86Tools hotkey-overlay-title="M1: Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    XF86Launch5 hotkey-overlay-title="M2: OCR Japanese" { spawn "nocblue-ocr-japanese"; }
    XF86Launch6 repeat=false hotkey-overlay-title="M3: Toggle Region Recording" { spawn "screen-record-toggle" "region"; }
    XF86Launch7 repeat=false hotkey-overlay-title="M4: Toggle Current Monitor Recording" { spawn "screen-record-toggle" "fullscreen"; }
    // Voxtype handles F17 press and release; keep M5 out of focused apps.
    XF86Launch8 repeat=false hotkey-overlay-title="M5: Dictation" { spawn "true"; }
    XF86Launch9 hotkey-overlay-title="M6: Session Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
}

hotkey-overlay {
    skip-at-startup
}

debug {
    honor-xdg-activation-with-invalid-serial
}
