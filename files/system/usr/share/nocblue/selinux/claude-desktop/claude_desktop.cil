(type claude_desktop_t)
(type claude_desktop_exec_t)
(roletype unconfined_r claude_desktop_t)
(roletype object_r claude_desktop_exec_t)
(typeattributeset domain (claude_desktop_t))
(typeattributeset application_domain_type (claude_desktop_t))
(typeattributeset corenet_unlabeled_type (claude_desktop_t))
(typeattributeset trivalent_domain (claude_desktop_t))
(typeattributeset kernel_system_state_reader (claude_desktop_t))
(typeattributeset pulseaudio_tmpfsfile (claude_desktop_t))
(typeattributeset nsswitch_domain (claude_desktop_t))
(typeattributeset x_domain (claude_desktop_t))
(typeattributeset xcolormap_type (claude_desktop_t))
(typeattributeset xdrawable_type (claude_desktop_t))
(typeattributeset nocblue_browser_wayland_clipboard_peer (claude_desktop_t))
(typeattributeset file_type (claude_desktop_exec_t))
(typeattributeset exec_type (claude_desktop_exec_t))
(typeattributeset entry_type (claude_desktop_exec_t))
(typeattributeset application_exec_type (claude_desktop_exec_t))
(typeattributeset non_auth_file_type (claude_desktop_exec_t))
(typeattributeset non_security_file_type (claude_desktop_exec_t))
(optional claude_desktop_userns_entrypoint
    (typeattributeset userns_privileged_file_type (claude_desktop_exec_t))
)

(type claude_desktop_launcher_t)
(type claude_desktop_launcher_exec_t)
(roletype unconfined_r claude_desktop_launcher_t)
(roletype object_r claude_desktop_launcher_exec_t)
(typeattributeset domain (claude_desktop_launcher_t))
(typeattributeset application_domain_type (claude_desktop_launcher_t))
(typeattributeset corenet_unlabeled_type (claude_desktop_launcher_t))
(typeattributeset trivalent_script_domain (claude_desktop_launcher_t))
(typeattributeset file_type (claude_desktop_launcher_exec_t))
(typeattributeset exec_type (claude_desktop_launcher_exec_t))
(typeattributeset entry_type (claude_desktop_launcher_exec_t))
(typeattributeset application_exec_type (claude_desktop_launcher_exec_t))
(typeattributeset non_auth_file_type (claude_desktop_launcher_exec_t))
(typeattributeset non_security_file_type (claude_desktop_launcher_exec_t))
(optional claude_desktop_launcher_userns_entrypoint
    (typeattributeset userns_privileged_file_type (claude_desktop_launcher_exec_t))
)

; Enter the fixed launcher with AT_SECURE before granting namespace access.
(allow unconfined_t claude_desktop_launcher_exec_t (file (getattr open read execute map)))
(allow unconfined_t claude_desktop_launcher_t (process (transition)))
(allow unconfined_t claude_desktop_launcher_t (process2 (nnp_transition nosuid_transition)))
(typetransition unconfined_t claude_desktop_launcher_exec_t process claude_desktop_launcher_t)
(allow unconfined_bubblewrap_t claude_desktop_launcher_exec_t (file (getattr open read execute map)))
(allow unconfined_bubblewrap_t claude_desktop_launcher_t (process (transition)))
(allow unconfined_bubblewrap_t claude_desktop_launcher_t (process2 (nnp_transition nosuid_transition)))
(typetransition unconfined_bubblewrap_t claude_desktop_launcher_exec_t process claude_desktop_launcher_t)
(allow claude_desktop_launcher_t claude_desktop_launcher_exec_t (file (entrypoint execute read getattr open map ioctl mounton)))
; Permit diagnostics through stdout or stderr redirected by the user.
(allow claude_desktop_launcher_t user_home_t (file (write)))
(allow claude_desktop_launcher_t unconfined_t (process (sigchld)))
(allow claude_desktop_launcher_t unconfined_t (fd (use)))
(allow claude_desktop_launcher_t unconfined_t (fifo_file (getattr read write append ioctl lock open)))
(allow claude_desktop_launcher_t unconfined_bubblewrap_t (process (sigchld)))
(allow claude_desktop_launcher_t unconfined_bubblewrap_t (fd (use)))
(allow claude_desktop_launcher_t unconfined_bubblewrap_t (fifo_file (getattr read write append ioctl lock open)))

; The launcher has scrubbed loader injection before the bundled ELF is run.
; Keeping AT_SECURE off here preserves Electron's $ORIGIN library search.
(allow claude_desktop_launcher_t claude_desktop_exec_t (file (getattr open read execute map)))
(allow claude_desktop_launcher_t claude_desktop_t (process (transition noatsecure siginh rlimitinh)))
(allow claude_desktop_launcher_t claude_desktop_t (process2 (nnp_transition nosuid_transition)))
(typetransition claude_desktop_launcher_t claude_desktop_exec_t process claude_desktop_t)
(allow claude_desktop_t claude_desktop_exec_t (file (entrypoint execute execute_no_trans read getattr open map ioctl)))
(allow claude_desktop_t claude_desktop_launcher_t (process (sigchld)))
(allow claude_desktop_t claude_desktop_launcher_t (fd (use)))
(allow claude_desktop_t claude_desktop_launcher_t (fifo_file (getattr read write append ioctl lock open)))
(allow claude_desktop_t unconfined_t (process (sigchld)))
(allow claude_desktop_t unconfined_t (fd (use)))
(allow claude_desktop_t unconfined_t (fifo_file (getattr read write append ioctl lock open)))

; Shell and system commands keep the normal desktop user's permissions.
(allow claude_desktop_t shell_exec_t (file (getattr open read execute map)))
(allow claude_desktop_t unconfined_t (process (transition noatsecure siginh rlimitinh)))
(allow claude_desktop_t unconfined_t (process2 (nnp_transition nosuid_transition)))
(typetransition claude_desktop_t shell_exec_t process unconfined_t)
(typetransition claude_desktop_t bin_t process unconfined_t)
(allow claude_desktop_t ssh_exec_t (file (getattr open read execute map)))
(typetransition claude_desktop_t ssh_exec_t process unconfined_t)
; The Code tab runs the Claude Code binary it downloads under ~/.config/Claude.
(allow claude_desktop_t config_home_t (file (execute)))
(allow unconfined_t config_home_t (file (entrypoint)))
(typetransition claude_desktop_t config_home_t process unconfined_t)
; The Code tab terminal gives those commands a user pty.
(allow claude_desktop_t ptmx_t (chr_file (getattr open read write ioctl)))
(allow claude_desktop_t devpts_t (dir (getattr open read search)))
(allow claude_desktop_t user_devpts_t (chr_file (getattr open read write ioctl setattr)))
(typetransition claude_desktop_t devpts_t chr_file user_devpts_t)
(allow unconfined_t claude_desktop_t (process (sigchld signull)))
(allow unconfined_t claude_desktop_t (fd (use)))
(allow unconfined_t claude_desktop_t (fifo_file (getattr read write append ioctl lock open)))

; Claude Code saves ~/.claude.json through a lock directory and a temporary file.
(typetransition claude_desktop_t user_home_dir_t file user_home_t)
(typetransition claude_desktop_t user_home_dir_t dir user_home_t)

; Chromium resources, desktop integration, and native account lookup.
(allow claude_desktop_t cache_home_t (file (map)))
(allow claude_desktop_t fonts_cache_t (dir (setattr)))
(allow claude_desktop_t cgroup_t (file (getattr open read)))
(allow claude_desktop_t usr_t (dir (watch)))
(allow claude_desktop_t systemd_resolved_var_run_t (dir (read)))
(allow claude_desktop_t systemd_userdbd_runtime_t (dir (read)))
(allow claude_desktop_t systemd_userdbd_runtime_t (lnk_file (read)))
(allow claude_desktop_t systemd_userdbd_runtime_t (sock_file (write)))
(allow claude_desktop_t unconfined_t (dir (search)))
(allow claude_desktop_t unconfined_t (file (open read)))
(allow claude_desktop_t unconfined_t (system (start status)))
(allow claude_desktop_t systemd_logind_t (dbus (send_msg)))
(allow claude_desktop_t systemd_logind_inhibit_var_run_t (fifo_file (write)))

; Claude checks the availability of its command and VM sandboxes at startup.
(allow claude_desktop_t nsfs_t (file (getattr)))
(allow claude_desktop_t sysctl_t (file (getattr open read)))
(allow claude_desktop_t claude_desktop_t (cap_userns (setpcap)))
(allow claude_desktop_t kvm_device_t (chr_file (read write)))
(allow claude_desktop_t vhost_device_t (chr_file (read write)))
(allow claude_desktop_t qemu_exec_t (file (execute)))

(filecon "/usr/lib/claude-desktop/claude-desktop" file (system_u object_r claude_desktop_launcher_exec_t ((s0)(s0))))
(filecon "/usr/lib/claude-desktop/claude-desktop[.]bin" file (system_u object_r claude_desktop_exec_t ((s0)(s0))))
(filecon "/usr/lib/claude-desktop/chrome_crashpad_handler" file (system_u object_r claude_desktop_exec_t ((s0)(s0))))
; Native helpers run with the desktop user's normal permissions.
(filecon "/usr/lib/claude-desktop/resources/cowork-linux-helper" file (system_u object_r bin_t ((s0)(s0))))
(filecon "/usr/lib/claude-desktop/resources/virtiofsd" file (system_u object_r bin_t ((s0)(s0))))
(filecon "/usr/lib/claude-desktop/resources/claude-ssh-askpass" file (system_u object_r bin_t ((s0)(s0))))
(filecon "/usr/lib/claude-desktop/resources/chrome-native-host" file (system_u object_r bin_t ((s0)(s0))))
