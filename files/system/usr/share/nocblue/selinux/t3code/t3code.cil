(type t3code_t)
(type t3code_exec_t)
(type t3code_launcher_t)
(type t3code_launcher_exec_t)
(roletype unconfined_r t3code_t)
(roletype unconfined_r t3code_launcher_t)
(roletype object_r t3code_exec_t)
(roletype object_r t3code_launcher_exec_t)
(typeattributeset domain (t3code_t t3code_launcher_t))
(typeattributeset application_domain_type (t3code_t t3code_launcher_t))
(typeattributeset corenet_unlabeled_type (t3code_t t3code_launcher_t))
(typeattributeset trivalent_domain (t3code_t))
(typeattributeset trivalent_script_domain (t3code_launcher_t))
(typeattributeset kernel_system_state_reader (t3code_t))
(typeattributeset pulseaudio_tmpfsfile (t3code_t))
(typeattributeset nsswitch_domain (t3code_t))
(typeattributeset x_domain (t3code_t))
(typeattributeset xcolormap_type (t3code_t))
(typeattributeset xdrawable_type (t3code_t))
(typeattributeset nocblue_browser_wayland_clipboard_peer (t3code_t))
(typeattributeset file_type (t3code_exec_t t3code_launcher_exec_t))
(typeattributeset exec_type (t3code_exec_t t3code_launcher_exec_t))
(typeattributeset entry_type (t3code_exec_t t3code_launcher_exec_t))
(typeattributeset application_exec_type (t3code_exec_t t3code_launcher_exec_t))
(typeattributeset non_auth_file_type (t3code_exec_t t3code_launcher_exec_t))
(typeattributeset non_security_file_type (t3code_exec_t t3code_launcher_exec_t))
(optional t3code_userns_privileges
    (typeattributeset userns_privileged_domain (t3code_t t3code_launcher_t))
    (typeattributeset userns_privileged_file_type (t3code_exec_t t3code_launcher_exec_t))
)

; The fixed launcher removes loader injection before either application path.
(allow unconfined_t t3code_launcher_exec_t (file (getattr open read execute map)))
(allow unconfined_t t3code_launcher_t (process (transition)))
(allow unconfined_t t3code_launcher_t (process2 (nnp_transition nosuid_transition)))
(typetransition unconfined_t t3code_launcher_exec_t process t3code_launcher_t)
(allow t3code_launcher_t t3code_launcher_exec_t (file (entrypoint execute read getattr open map ioctl)))
(allow t3code_launcher_t t3code_exec_t (file (getattr open read execute map)))
(allow t3code_launcher_t t3code_t (process (transition noatsecure siginh rlimitinh)))
(allow t3code_launcher_t t3code_t (process2 (nnp_transition nosuid_transition)))
(typetransition t3code_launcher_t t3code_exec_t process t3code_t)
(allow t3code_t t3code_exec_t (file (entrypoint execute execute_no_trans read getattr open map ioctl)))
(allow t3code_t t3code_launcher_t (process (sigchld)))
(allow t3code_t t3code_launcher_t (fd (use)))
(allow t3code_t t3code_launcher_t (fifo_file (getattr read write append ioctl lock open)))
(allow t3code_launcher_t unconfined_t (process (sigchld)))
(allow t3code_launcher_t unconfined_t (fd (use)))
(allow t3code_launcher_t unconfined_t (fifo_file (getattr read write append ioctl lock open)))
(allow t3code_launcher_t user_home_t (file (write)))
(allow t3code_launcher_t t3code_launcher_t (user_namespace (create)))
(allow t3code_t t3code_t (user_namespace (create)))

; The backend uses a separate Electron copy with the normal user domain.
(allow t3code_launcher_t bin_t (file (getattr open read execute map)))
(allow t3code_launcher_t unconfined_t (process (transition noatsecure siginh rlimitinh)))
(allow t3code_launcher_t unconfined_t (process2 (nnp_transition nosuid_transition)))
(typetransition t3code_launcher_t bin_t process unconfined_t)
(allow t3code_t unconfined_t (process (transition noatsecure siginh rlimitinh signal sigkill signull)))
(allow t3code_t unconfined_t (process2 (nnp_transition nosuid_transition)))
(typetransition t3code_t shell_exec_t process unconfined_t)
(typetransition t3code_t bin_t process unconfined_t)
(typetransition t3code_t t3code_launcher_exec_t process t3code_launcher_t)
(allow t3code_t t3code_launcher_exec_t (file (getattr open read execute map)))
(allow t3code_t t3code_launcher_t (process (transition)))
(allow t3code_t t3code_launcher_t (process2 (nnp_transition nosuid_transition)))
(allow unconfined_t t3code_t (process (sigchld signull)))
(allow unconfined_t t3code_t (fd (use)))
(allow unconfined_t t3code_t (fifo_file (getattr read write append ioctl lock open)))
(allow unconfined_t t3code_launcher_t (process (sigchld)))
(allow t3code_t unconfined_t (fd (use)))
(allow t3code_t unconfined_t (fifo_file (getattr read write append ioctl lock open)))
(allow t3code_t unconfined_t (dir (search)))
(allow t3code_t unconfined_t (file (getattr open read)))
(allow t3code_t unconfined_t (system (start status)))
(allow t3code_t cache_home_t (file (map)))
(allow t3code_t cgroup_t (file (getattr open read)))
(allow t3code_t usr_t (dir (watch)))
(allow t3code_t var_lib_t (dir (watch)))
(allow t3code_t user_tmp_t (dir (create setattr watch rmdir)))
(allow t3code_t user_tmp_t (lnk_file (create getattr read unlink)))
(allow t3code_t proc_net_t (lnk_file (read)))
(allow t3code_t proc_net_t (file (getattr open read)))
(allow t3code_t unreserved_port_t (tcp_socket (name_bind)))
(allow t3code_t systemd_logind_t (dbus (send_msg)))
(allow systemd_logind_t t3code_t (dbus (send_msg)))
(allow t3code_t systemd_logind_inhibit_var_run_t (fifo_file (write)))
(allow t3code_t systemd_resolved_var_run_t (dir (read)))
(allow t3code_t systemd_userdbd_runtime_t (dir (read)))
(allow t3code_t systemd_userdbd_runtime_t (lnk_file (read)))
(allow t3code_t systemd_userdbd_runtime_t (sock_file (write)))
(allow t3code_t t3code_t (cap_userns (setpcap)))
; The backend launcher inherits Electron's diagnostic and browser-control FDs.
(allow t3code_launcher_t t3code_t (fifo_file (read write)))
(allow t3code_launcher_t t3code_t (unix_stream_socket (ioctl)))
(allow t3code_launcher_t dri_device_t (chr_file (read write)))
(allow t3code_launcher_t tmpfs_t (file (read write)))

; Fedora matches /usr/lib64 paths through the /usr/lib context alias.
(filecon "/usr/lib/t3code-nightly/t3code" file (system_u object_r t3code_launcher_exec_t ((s0)(s0))))
(filecon "/usr/lib/t3code-nightly/t3code[.]bin" file (system_u object_r t3code_exec_t ((s0)(s0))))
(filecon "/usr/lib/t3code-nightly/chrome_crashpad_handler" file (system_u object_r t3code_exec_t ((s0)(s0))))
(filecon "/usr/lib/t3code-nightly/t3code[.]node" file (system_u object_r bin_t ((s0)(s0))))
(filecon "/usr/lib/t3code-nightly/resources/(browser-secret|resource-monitor|hyprland-capture|kde-capture)" file (system_u object_r bin_t ((s0)(s0))))
