(type claude_sandbox_helper_t)
(type claude_sandbox_helper_exec_t)
(roletype unconfined_r claude_sandbox_helper_t)
(roletype object_r claude_sandbox_helper_exec_t)
(typeattributeset domain (claude_sandbox_helper_t))
(typeattributeset application_domain_type (claude_sandbox_helper_t))
(typeattributeset corenet_unlabeled_type (claude_sandbox_helper_t))
(typeattributeset file_type (claude_sandbox_helper_exec_t))
(typeattributeset exec_type (claude_sandbox_helper_exec_t))
(typeattributeset entry_type (claude_sandbox_helper_exec_t))
(typeattributeset application_exec_type (claude_sandbox_helper_exec_t))
(typeattributeset non_auth_file_type (claude_sandbox_helper_exec_t))
(typeattributeset non_security_file_type (claude_sandbox_helper_exec_t))
(optional claude_sandbox_userns_privileges
    (typeattributeset userns_privileged_domain (claude_sandbox_helper_t))
    (typeattributeset userns_privileged_file_type (claude_sandbox_helper_exec_t))
)

(allow unconfined_t claude_sandbox_helper_exec_t (file (getattr open read execute map)))
(allow unconfined_t claude_sandbox_helper_t (process (transition)))
(allow unconfined_t claude_sandbox_helper_t (process2 (nnp_transition nosuid_transition)))
(typetransition unconfined_t claude_sandbox_helper_exec_t process claude_sandbox_helper_t)
(allow claude_sandbox_helper_t claude_sandbox_helper_exec_t (file (entrypoint execute read getattr open map)))
(allow claude_sandbox_helper_t claude_sandbox_helper_t (user_namespace (create)))
(allow claude_sandbox_helper_t claude_sandbox_helper_t (cap_userns (sys_admin)))
; The helper maps its own IDs and mounts /proc inside the new namespace.
(allow claude_sandbox_helper_t claude_sandbox_helper_t (file (getattr open read write)))
(allow claude_sandbox_helper_t non_security_file_type (dir (getattr search mounton)))
(allow claude_sandbox_helper_t proc_t (filesystem (mount)))
(allow claude_sandbox_helper_t filesystem_type (filesystem (remount)))
(allow claude_sandbox_helper_t sysctl_t (dir (search)))
(allow claude_sandbox_helper_t sysctl_t (file (getattr open read write)))

; Leave the helper domain before executing the requested command.
(deny claude_sandbox_helper_t file_type (file (execute_no_trans)))
(allow claude_sandbox_helper_t shell_exec_t (file (getattr open read execute map)))
(allow claude_sandbox_helper_t bin_t (file (getattr open read execute map)))
(allow claude_sandbox_helper_t unconfined_t (process (transition noatsecure siginh rlimitinh sigchld signal sigkill signull)))
(allow claude_sandbox_helper_t unconfined_t (process2 (nnp_transition nosuid_transition)))
(typetransition claude_sandbox_helper_t shell_exec_t process unconfined_t)
(typetransition claude_sandbox_helper_t bin_t process unconfined_t)
(allow claude_sandbox_helper_t unconfined_t (fd (use)))
(allow claude_sandbox_helper_t unconfined_t (fifo_file (getattr read write append ioctl lock open)))
(allow unconfined_t claude_sandbox_helper_t (process (sigchld signull)))
(allow unconfined_t claude_sandbox_helper_t (fd (use)))
(allow unconfined_t claude_sandbox_helper_t (fifo_file (getattr read write append ioctl lock open)))

(filecon "/usr/libexec/claude-sandbox/apply-seccomp" file (system_u object_r claude_sandbox_helper_exec_t ((s0)(s0))))
