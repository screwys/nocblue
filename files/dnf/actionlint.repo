[copr:copr.fedorainfracloud.org:sim0n:toolbox]
name=Copr repo for toolbox owned by sim0n
baseurl=https://download.copr.fedorainfracloud.org/results/sim0n/toolbox/fedora-$releasever-$basearch/
type=rpm-md
skip_if_unavailable=False
gpgcheck=1
gpgkey=https://download.copr.fedorainfracloud.org/results/sim0n/toolbox/pubkey.gpg
repo_gpgcheck=0
enabled=1
enabled_metadata=1
includepkgs=actionlint
