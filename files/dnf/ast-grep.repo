[copr:copr.fedorainfracloud.org:marcin:agentlab]
name=Copr repo for agentlab owned by marcin
baseurl=https://download.copr.fedorainfracloud.org/results/marcin/agentlab/fedora-$releasever-$basearch/
type=rpm-md
